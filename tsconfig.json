{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "target": "es2017",
    "noImplicitAny": true,
    "declaration": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests.test.js", "vitest.*"]
}
