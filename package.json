{
  "name": "tarn",
  "version": "3.0.1",
  "description": "Simple and robust resource pool for node.js",
  "main": "dist/tarn.js",
  "types": "dist/tarn.d.ts",
  "license": "MIT",
  "scripts": {
    "pretest": "npm run build",
    "test": "vitest run",
    "test-bail": "vitest run --bail 1",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsc",
    "lint": "eslint --format codeframe \"src/**/*.ts\"",
    "format": "prettier **/*.{js,ts} --write"
  },
  "author": {
    "name": "Sami Koskimäki",
    "email": "sami.koskimaki@vincit.com",
    "url": "https://github.com/koskimas"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/vincit/tarn.js.git"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "keywords": [
    "pool",
    "pooling",
    "throttle"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "dist/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "git add"
    ]
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^2.21.0",
    "@typescript-eslint/parser": "^2.21.0",
    "bluebird": "^3.7.2",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.0",
    "eslint-plugin-prettier": "^3.1.2",
    "husky": "^1.3.1",
    "lint-staged": "^9.5.0",
    "prettier": "^1.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
